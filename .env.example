# Apple credentials for code signing & notarization
# Copy this file to .env and fill in your values (never commit .env)

APPLE_ID=your.email@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_IDENTITY=Developer ID Application: YOUR NAME (XXXXXXXXXX)

# Mixpanel project token, baked into the renderer bundle at build time.
# Leave it unset and usage tracking disables itself — which is what you want
# locally, so development never writes into the production project.
MIXPANEL_TOKEN=
